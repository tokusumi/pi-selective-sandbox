{
  "name": "pi-selective-sandbox",
  "version": "0.1.0",
  "private": true,
  "description": "Sandbox-first, selectively escalating execution for Pi",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./pi-extension": "./dist/pi-extension.js"
  },
  "pi": {
    "extensions": ["./src/pi-extension.ts"]
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.76",
    "@spences10/pi-redact": "^0.0.15",
    "@spences10/pi-skills": "^0.0.36"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  }
}
